# These image/document trees are deterministic build outputs regenerated from
# pics/ + assets-src/ by prepare-dama-venus-assets-current-epk.mjs. Keeping
# committed generated copies in the Docker context duplicates hundreds of MB.
# The manually managed video directory remains in the context.
public/assets/dama-venus/about/
public/assets/dama-venus/contact/
public/assets/dama-venus/curated/
public/assets/dama-venus/docs/
