# Required
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://damavenus.eu

# Required in production: choose "webhook" or "resend".
# "noop" is accepted only outside production and production requests fail closed.
CONTACT_PROVIDER=

# Provider-specific: webhook
CONTACT_WEBHOOK_URL=
CONTACT_API_KEY=
CONTACT_TO_EMAIL=

# Provider-specific: resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
